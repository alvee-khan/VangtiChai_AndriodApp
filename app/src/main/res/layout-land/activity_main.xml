<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:fitsSystemWindows="true"
        android:background="@color/toolbar_teal"
        app:title="@string/app_name"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/amountRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/amount_top_margin"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTakaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/taka_label"
            android:textSize="@dimen/amount_text_size"
            android:textColor="@android:color/black"
            android:layout_marginEnd="@dimen/amount_label_gap" />

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/initial_amount"
            android:textSize="@dimen/amount_text_size"
            android:textColor="@android:color/black" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/content_top_margin"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintTop_toBottomOf="@id/amountRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/notesContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNote500"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_500"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvNote100"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_100"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvNote50"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_50"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvNote20"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_20"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/key_gap">

                <TextView
                    android:id="@+id/tvNote10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_10"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvNote5"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_5"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvNote2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_2"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvNote1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/note_row_height"
                    android:gravity="center_vertical"
                    android:text="@string/note_1"
                    android:textSize="@dimen/note_text_size"
                    android:textColor="@android:color/black" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/key_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/key_gap">

                <Button
                    android:id="@+id/btn1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_1"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btn2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_2"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btn3"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_3"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btn4"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_4"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/key_gap">

                <Button
                    android:id="@+id/btn5"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_5"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btn6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_6"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btn7"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_7"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btn8"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_8"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn9"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_9"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btn0"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/key_gap"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_0"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/key_height"
                    android:layout_weight="2"
                    android:background="@drawable/keypad_button_bg"
                    android:backgroundTint="@color/keypad_button_bg"
                    app:backgroundTint="@color/keypad_button_bg"
                    android:text="@string/key_clear"
                    android:textAllCaps="false"
                    android:textColor="@color/keypad_button_text"
                    android:textSize="@dimen/key_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>